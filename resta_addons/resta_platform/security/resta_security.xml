<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_resta" model="ir.module.category">
        <field name="name">منصة ريستا</field>
        <field name="sequence">60</field>
    </record>
    <record id="res_groups_privilege_resta" model="res.groups.privilege">
        <field name="name">منصة ريستا</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="module_category_resta"/>
    </record>
    <record id="group_resta_user" model="res.groups">
        <field name="name">مشغّل المنصة</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_resta"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">يشوف المشاريع والسيرفرات ويطلب العمليات اليومية</field>
    </record>
    <record id="group_resta_manager" model="res.groups">
        <field name="name">مدير المنصة</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_resta"/>
        <field name="implied_ids" eval="[(4, ref('group_resta_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">كل الصلاحيات: إنشاء وحذف السيرفرات والباقات والإعدادات</field>
    </record>
</odoo>
