<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_resta" model="ir.ui.view">
        <field name="name">account.move.form.resta</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="resta_project_id" invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
    <record id="action_resta_invoices" model="ir.actions.act_window">
        <field name="name">فواتير الاشتراكات</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('resta_project_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>
</odoo>
