<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_resta_plan_list" model="ir.ui.view">
        <field name="name">resta.plan.list</field>
        <field name="model">resta.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="project_type"/>
                <field name="edition"/>
                <field name="base_price"/>
                <field name="price_per_branch"/>
                <field name="is_default"/>
                <field name="project_count"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_resta_plan_form" model="ir.ui.view">
        <field name="name">resta.plan.form</field>
        <field name="model">resta.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="project_type"/>
                            <field name="edition" invisible="project_type != 'saas'"/>
                            <field name="is_default" invisible="project_type != 'saas'"/>
                            <field name="product_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="base_price"/>
                            <field name="included_branches"/>
                            <field name="price_per_branch"/>
                            <field name="included_storage_gb"/>
                            <field name="price_per_gb"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="السيرفر الخاص" invisible="project_type != 'custom'">
                            <field name="machine_type"/>
                            <field name="disk_gb"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_resta_plan" model="ir.actions.act_window">
        <field name="name">الباقات</field>
        <field name="res_model">resta.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
